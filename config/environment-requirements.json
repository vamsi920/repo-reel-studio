{
  "$comment": "Single source of truth for what a NeoDevEx install requires from its host environment. Consumed by src/lib/environment/requirements (typed graph, UI) and scripts/environment-preflight.mjs (standalone CLI). Keep vendor-specific egress in the connector manifests; only platform-wide entries belong here.",
  "schemaVersion": 1,
  "platformEgress": [
    { "host": "api.github.com", "port": 443, "purposeKey": "PROBE$EGRESS_GITHUB_API", "mirrorable": false },
    { "host": "github.com", "port": 443, "purposeKey": "PROBE$EGRESS_GITHUB_WEB", "mirrorable": false },
    { "host": "registry.npmjs.org", "port": 443, "purposeKey": "PROBE$EGRESS_NPM", "mirrorable": true },
    { "host": "nodejs.org", "port": 443, "purposeKey": "PROBE$EGRESS_NODE_DIST", "mirrorable": true },
    { "host": "pypi.org", "port": 443, "purposeKey": "PROBE$EGRESS_PYPI", "mirrorable": true },
    { "host": "astral.sh", "port": 443, "purposeKey": "PROBE$EGRESS_UV", "mirrorable": true },
    { "host": "ghcr.io", "port": 443, "purposeKey": "PROBE$EGRESS_GHCR", "mirrorable": true },
    { "host": "fonts.googleapis.com", "port": 443, "purposeKey": "PROBE$EGRESS_FONTS", "mirrorable": true, "requiredFor": [] }
  ],
  "featureEgress": [
    { "host": "generativelanguage.googleapis.com", "port": 443, "purposeKey": "PROBE$EGRESS_GEMINI", "mirrorable": false, "requiredFor": ["conversation.start", "knowledge.deepwiki"] },
    { "host": "api.openai.com", "port": 443, "purposeKey": "PROBE$EGRESS_OPENAI", "mirrorable": false, "requiredFor": ["conversation.start"] },
    { "host": "auth.atlassian.com", "port": 443, "purposeKey": "PROBE$EGRESS_ATLASSIAN_AUTH", "mirrorable": false, "requiredFor": ["automations.jira-trigger"] },
    { "host": "api.atlassian.com", "port": 443, "purposeKey": "PROBE$EGRESS_ATLASSIAN_API", "mirrorable": false, "requiredFor": ["automations.jira-trigger"] },
    { "host": "us.i.posthog.com", "port": 443, "purposeKey": "PROBE$EGRESS_POSTHOG", "mirrorable": false, "requiredFor": ["telemetry"] },
    { "host": "app.all-hands.dev", "port": 443, "purposeKey": "PROBE$EGRESS_OPENHANDS_CLOUD", "mirrorable": false, "requiredFor": ["backend.cloud"] }
  ],
  "hostBinaries": [
    { "name": "node", "minVersion": "22.12.0", "versionArgs": ["--version"], "purposeKey": "PROBE$BINARY_NODE" },
    { "name": "git", "versionArgs": ["--version"], "purposeKey": "PROBE$BINARY_GIT" },
    { "name": "uvx", "versionArgs": ["--version"], "purposeKey": "PROBE$BINARY_UVX" },
    { "name": "python3", "minVersion": "3.11.0", "versionArgs": ["--version"], "purposeKey": "PROBE$BINARY_PYTHON" },
    { "name": "npx", "versionArgs": ["--version"], "purposeKey": "PROBE$BINARY_NPX" },
    { "name": "docker", "versionArgs": ["--version"], "optional": true, "purposeKey": "PROBE$BINARY_DOCKER" }
  ],
  "pgExtensions": [
    { "name": "vector", "purposeKey": "PROBE$PGEXT_VECTOR" },
    { "name": "pgcrypto", "purposeKey": "PROBE$PGEXT_PGCRYPTO" },
    { "name": "pg_cron", "purposeKey": "PROBE$PGEXT_PG_CRON" },
    { "name": "pg_net", "purposeKey": "PROBE$PGEXT_PG_NET" },
    { "name": "pgmq", "purposeKey": "PROBE$PGEXT_PGMQ", "optional": true },
    { "name": "supabase_vault", "purposeKey": "PROBE$PGEXT_VAULT" }
  ],
  "storageBuckets": [
    { "name": "workspace-artifacts", "public": false, "purposeKey": "PROBE$BUCKET_ARTIFACTS" },
    { "name": "kt-audio", "public": false, "purposeKey": "PROBE$BUCKET_KT_AUDIO" }
  ],
  "envVars": [
    { "name": "VITE_BACKEND_BASE_URL", "scope": "netlify", "secret": false, "purposeKey": "PROBE$ENV_BACKEND_BASE_URL" },
    { "name": "VITE_SESSION_API_KEY", "scope": "netlify", "secret": true, "purposeKey": "PROBE$ENV_SESSION_API_KEY" },
    { "name": "VITE_SUPABASE_URL", "scope": "netlify", "secret": false, "purposeKey": "PROBE$ENV_SUPABASE_URL" },
    { "name": "VITE_SUPABASE_PUBLISHABLE_KEY", "scope": "netlify", "secret": false, "purposeKey": "PROBE$ENV_SUPABASE_KEY" },
    { "name": "VITE_DEEPWIKI_SERVICE_URL", "scope": "netlify", "secret": false, "purposeKey": "PROBE$ENV_DEEPWIKI_URL" },
    { "name": "LOCAL_BACKEND_API_KEY", "scope": "fly", "secret": true, "purposeKey": "PROBE$ENV_LOCAL_BACKEND_API_KEY" },
    { "name": "OH_SECRET_KEY", "scope": "fly", "secret": true, "purposeKey": "PROBE$ENV_OH_SECRET_KEY", "autoGenerated": true },
    { "name": "FILE_STORE", "scope": "fly", "secret": false, "expected": "local", "purposeKey": "PROBE$ENV_FILE_STORE" },
    { "name": "SUPABASE_SERVICE_ROLE_KEY", "scope": "supabase-edge", "secret": true, "purposeKey": "PROBE$ENV_SERVICE_ROLE_KEY" },
    { "name": "GITHUB_TOKEN_ENCRYPTION_KEY", "scope": "supabase-edge", "secret": true, "purposeKey": "PROBE$ENV_TOKEN_ENCRYPTION_KEY" },
    { "name": "CONNECTION_SECRET_ENCRYPTION_KEY", "scope": "supabase-edge", "secret": true, "purposeKey": "PROBE$ENV_CONNECTION_ENCRYPTION_KEY" },
    { "name": "APP_ORIGIN", "scope": "supabase-edge", "secret": false, "purposeKey": "PROBE$ENV_APP_ORIGIN" }
  ],
  "envPairs": [
    {
      "id": "session-key-drift",
      "a": { "scope": "netlify", "name": "VITE_SESSION_API_KEY" },
      "b": { "scope": "fly", "name": "LOCAL_BACKEND_API_KEY" },
      "purposeKey": "PROBE$ENV_PAIR_SESSION_KEY",
      "$comment": "Nothing syncs these. Drift produces 401s on authenticated endpoints ONLY, so /health still returns 200 and the failure looks random. Verified by the backend-key probe hitting an authenticated endpoint."
    }
  ],
  "features": [
    {
      "featureId": "conversation.start",
      "nameKey": "REQUIREMENT$FEATURE_CONVERSATION_START",
      "requires": [
        { "node": { "kind": "env", "scope": "netlify", "name": "VITE_BACKEND_BASE_URL" }, "severity": "blocking" },
        { "node": { "kind": "env-pair", "id": "session-key-drift" }, "severity": "blocking" },
        { "node": { "kind": "capability", "capability": "llm" }, "severity": "blocking" }
      ]
    },
    {
      "featureId": "repositories.browse",
      "nameKey": "REQUIREMENT$FEATURE_REPOSITORIES",
      "requires": [
        { "node": { "kind": "capability", "capability": "source-control" }, "severity": "blocking" },
        { "node": { "kind": "env", "scope": "supabase-edge", "name": "GITHUB_TOKEN_ENCRYPTION_KEY" }, "severity": "blocking" }
      ]
    },
    {
      "featureId": "knowledge.deepwiki",
      "nameKey": "REQUIREMENT$FEATURE_KNOWLEDGE",
      "requires": [
        { "node": { "kind": "env", "scope": "netlify", "name": "VITE_DEEPWIKI_SERVICE_URL" }, "severity": "blocking" },
        { "node": { "kind": "capability", "capability": "llm" }, "severity": "blocking" }
      ]
    },
    {
      "featureId": "memory.vector-search",
      "nameKey": "REQUIREMENT$FEATURE_MEMORY_SEARCH",
      "requires": [
        { "node": { "kind": "capability", "capability": "vector-store" }, "severity": "degrading", "degradesToKey": "REQUIREMENT$DEGRADE_MEMORY_SEARCH" },
        { "node": { "kind": "pg-extension", "name": "vector" }, "severity": "degrading", "degradesToKey": "REQUIREMENT$DEGRADE_MEMORY_SEARCH" }
      ]
    },
    {
      "featureId": "automations.run",
      "nameKey": "REQUIREMENT$FEATURE_AUTOMATIONS",
      "requires": [
        { "node": { "kind": "env", "scope": "fly", "name": "FILE_STORE" }, "severity": "blocking" }
      ]
    },
    {
      "featureId": "automations.jira-trigger",
      "nameKey": "REQUIREMENT$FEATURE_JIRA_TRIGGER",
      "requires": [
        { "node": { "kind": "capability", "capability": "issue-tracker" }, "severity": "blocking" },
        { "node": { "kind": "pg-extension", "name": "pg_cron" }, "severity": "blocking" },
        { "node": { "kind": "pg-extension", "name": "pg_net" }, "severity": "blocking" },
        { "node": { "kind": "inbound", "path": "/functions/v1/jira-webhook-receiver" }, "severity": "degrading", "degradesToKey": "REQUIREMENT$DEGRADE_WEBHOOK_POLLING" }
      ]
    },
    {
      "featureId": "collaboration.workspace",
      "nameKey": "REQUIREMENT$FEATURE_COLLABORATION",
      "requires": [
        { "node": { "kind": "env", "scope": "netlify", "name": "VITE_SUPABASE_URL" }, "severity": "degrading", "degradesToKey": "REQUIREMENT$DEGRADE_LOCAL_ONLY" },
        { "node": { "kind": "storage-bucket", "name": "workspace-artifacts" }, "severity": "degrading", "degradesToKey": "REQUIREMENT$DEGRADE_LOCAL_ONLY" }
      ]
    },
    {
      "featureId": "agentops.persistence",
      "nameKey": "REQUIREMENT$FEATURE_AGENTOPS",
      "requires": [
        { "node": { "kind": "env", "scope": "supabase-edge", "name": "SUPABASE_SERVICE_ROLE_KEY" }, "severity": "degrading", "degradesToKey": "REQUIREMENT$DEGRADE_AGENTOPS_JSONL" }
      ]
    },
    {
      "featureId": "agent.sandbox",
      "nameKey": "REQUIREMENT$FEATURE_SANDBOX",
      "requires": [
        { "node": { "kind": "host-binary", "name": "git" }, "severity": "blocking" },
        { "node": { "kind": "host-binary", "name": "uvx" }, "severity": "blocking" },
        { "node": { "kind": "egress", "host": "registry.npmjs.org", "port": 443 }, "severity": "degrading", "degradesToKey": "REQUIREMENT$DEGRADE_NO_PACKAGE_INSTALL" },
        { "node": { "kind": "egress", "host": "pypi.org", "port": 443 }, "severity": "degrading", "degradesToKey": "REQUIREMENT$DEGRADE_NO_PACKAGE_INSTALL" }
      ]
    },
    {
      "featureId": "auth.signup",
      "nameKey": "REQUIREMENT$FEATURE_SIGNUP",
      "requires": [
        { "node": { "kind": "deployment-defect", "id": "signup-domain-hardcoded" }, "severity": "blocking" }
      ]
    },
    {
      "featureId": "telemetry",
      "nameKey": "REQUIREMENT$FEATURE_TELEMETRY",
      "requires": [
        { "node": { "kind": "egress", "host": "us.i.posthog.com", "port": 443 }, "severity": "optional" }
      ]
    }
  ],
  "deploymentDefects": [
    {
      "id": "signup-domain-hardcoded",
      "nameKey": "PROBE$DEFECT_SIGNUP_DOMAIN",
      "check": "signup-domain-allowlist-present",
      "remediationKey": "PROBE$DEFECT_SIGNUP_DOMAIN_FIX"
    },
    {
      "id": "functions-base-url-unset",
      "nameKey": "PROBE$DEFECT_FUNCTIONS_BASE_URL",
      "check": "app-functions-base-url-setting",
      "remediationKey": "PROBE$DEFECT_FUNCTIONS_BASE_URL_FIX"
    },
    {
      "id": "file-store-unset",
      "nameKey": "PROBE$DEFECT_FILE_STORE",
      "check": "file-store-local",
      "remediationKey": "PROBE$DEFECT_FILE_STORE_FIX"
    }
  ]
}
