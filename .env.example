# Supabase (database — projects, project memory, SME desk, agent runs, onboarding sessions)
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
# Server-side only (Python agent-runs / requirements-engine services). NEVER expose to the client.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Gemini AI Configuration
VITE_GEMINI_API_KEY=your_gemini_api_key_here
# Use API model ID only (e.g. gemini-2.5-flash). See https://ai.google.dev/api/models
VITE_GEMINI_MODEL=gemini-2.5-flash
# Production frontend → backend URL (required on AWS; baked at build time).
# Example: https://api.example.com
VITE_API_URL=

# Server-side tiny model for proactive live console narration.
PROACTIVE_LOG_MODEL=gemini-2.5-flash-lite
# Proactive sandbox executor wall-clock timeout (seconds). Default 1200; min 60, max 7200.
# PROACTIVE_EXECUTOR_TIMEOUT_SECONDS=1200
# Proactive cron: Bearer for POST /api/proactive/dispatch-daily when set (see docs/PROACTIVE_DISPATCH_CRON.md).
# PROACTIVE_CRON_TOKEN=
# Base URL for HTTP cron helper (defaults to AGENT_RUNS_PROXY_URL or http://127.0.0.1:8788).
# PROACTIVE_DISPATCH_API_BASE=http://127.0.0.1:8788

# Google Cloud TTS Configuration (optional, proxy-only)
VITE_GOOGLE_TTS_ENABLED=false
# Set this only on the Node/Python server or AWS ECS task (prefer SSM). Never use a VITE_ key.
# GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# Feature Flags
VITE_USE_MOCK_MANIFEST=false

# Graphify (code graph extract + path/explain for Repo Q&A). Default ON.
# Ingest runs `graphify extract --code-only` and, when projectId is present,
# persists graphify-out under server/.repo-workspaces/ for POST /api/graph/path
# and /api/graph/explain. Set USE_GRAPHIFY=false to disable.
# USE_GRAPHIFY=false
# INGEST_GRAPHIFY_TIMEOUT_MS=60000

# Caveman Helper: lightweight token compression for Agent Ops + Proactive prompts.
# Enabled by default — set to 0 to disable. See /token-savings for measured savings.
# CAVEMAN_HELPER_ENABLED=1
# CAVEMAN_HELPER_MODE=lite

# AWS / production backend (Node ECS task — not VITE_)
# Comma-separated browser origins allowed by ingestion API (include app + CloudFront URLs).
# CORS_ORIGINS=https://app.example.com,https://d123.cloudfront.net
# AGENT_RUNS_PROXY_URL=http://agent-api.neodevex.local:8788
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=
# GEMINI_API_KEY=
# GOOGLE_TTS_API_KEY=

# Ingestion limits: cap how much of the repo is read (avoids OOM / timeouts).
# Defaults: 120 files, 6 MB total, 512 KB per file. Large repos (e.g. ever-co/ever-gauzy)
# will show many "Skipped Files" until you raise these (server/env only, not VITE_).
# INGEST_MAX_FILES=120
# INGEST_MAX_TOTAL_BYTES=6291456
# INGEST_MAX_FILE_BYTES=524288
# INGEST_USE_ARCHIVE=true
